---
import Layout from "../layouts/Layout.astro";

if (Astro.locals.user) return Astro.redirect("/dashboard/servers");
---

<Layout title="Sign in">
	<h1 class="mb-2 text-3xl font-bold">Global Ban</h1>
	<p class="mb-6 text-slate-400">
		Manage servers, communities and shared punishments.
	</p>
	<button
		id="login"
		class="rounded bg-slate-100 px-4 py-2 font-medium text-slate-900"
		>Sign in with GitHub</button
	>
	<p class="mt-6 text-slate-400">
		Banned and think it was a mistake?
		<a href="/appeal" class="underline hover:text-white">Appeal a ban</a>
	</p>
	<script>
		import { createAuthClient } from "better-auth/client";
		const client = createAuthClient();
		document.getElementById("login")?.addEventListener("click", () => {
			client.signIn.social({
				provider: "github",
				callbackURL: "/dashboard/servers",
			});
		});
	</script>
</Layout>

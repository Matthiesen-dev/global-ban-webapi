---
import "../styles/global.css";
interface Props {
    title: string;
}
const { title } = Astro.props;
const user = Astro.locals.user;

const navLinks = [
    {
        href: "/dashboard/servers",
        label: "Servers",
    },
    {
        href: "/dashboard/communities",
        label: "Communities",
    },
    {
        href: "/dashboard/punishments",
        label: "Punishments",
    },
    {
        href: "/dashboard/appeals",
        label: "Appeals",
    },
    {
        href: "/dashboard/transfers",
        label: "Transfers",
    },
];

const pageTitle = title ? `${title} | Global Ban` : "Global Ban";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        <meta name="title" content={pageTitle} />
        <meta
            name="description"
            content="Global Ban is a service for managing shared bans across multiple servers."
        />
        <meta name="theme-color" content="#0f172a" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>
    <body class="min-h-screen bg-slate-950 text-slate-100">
        <header class="border-b border-slate-800">
            <nav class="mx-auto flex max-w-5xl items-center gap-6 p-4">
                <a href="/" class="font-semibold">Global Ban</a>
                {
                    user && (
                        <>
                            {navLinks.map((link) => (
                                <a
                                    href={link.href}
                                    class="text-slate-300 hover:text-white"
                                >
                                    {link.label}
                                </a>
                            ))}
                            <form
                                method="post"
                                action="/logout"
                                class="ml-auto"
                            >
                                <button class="text-slate-400 hover:text-white">
                                    Sign out ({user.name})
                                </button>
                            </form>
                        </>
                    )
                }
            </nav>
        </header>
        <main class="mx-auto max-w-5xl p-4">
            <slot />
        </main>
    </body>
</html>
